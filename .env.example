# ============================================================
# Portal — переменные окружения
# Скопируйте в .env и заполните значения
# НИКОГДА не коммитьте .env в git
#
# Настройки Nextcloud, CIDR, TLS, базового URL, Prometheus
# управляются через Admin UI (Администрирование → Система)
# и сохраняются в /data/settings/system.json
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=change_me_strong_password

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password

# ── Backend (FastAPI) ────────────────────────────────────────
SECRET_KEY=change_me_32_chars_minimum_secret_key_here
ENVIRONMENT=production

# Полный asyncpg URL (подставляется автоматически в docker-compose)
DATABASE_URL=postgresql+asyncpg://portal:change_me_strong_password@postgres:5432/portal
REDIS_URL=redis://:change_me_redis_password@redis:6379/0

# ── Sentry (error tracking) ──────────────────────────────────
# Оставить пустым если Sentry не используется
SENTRY_DSN=

# ── Логирование ──────────────────────────────────────────────
# LOG_LEVEL управляется через Admin UI → Система → Наблюдаемость
# Принудительно JSON-рендер логов (true для prod/staging, false для локального dev).
# Пусто (по умолчанию) — JSON автоматически вне dev или когда stdout не TTY.
LOG_FORCE_JSON=
# Порог в мс, после которого HTTP-запрос логируется как WARNING (slow request).
LOG_SLOW_REQUEST_MS=1000

# Включить вывод всех SQL-запросов в логи (только для отладки, НЕ в production)
DB_ECHO=false

# ── ARQ Worker ───────────────────────────────────────────────
# Количество одновременных задач в worker
ARQ_MAX_JOBS=10

# ── Локальная аутентификация ──────────────────────────────────
# Включить/выключить вход по email+паролю (аварийный/bootstrap режим)
LOCAL_AUTH_ENABLED=true
# Email и пароль первого admin (bootstrap при первом запуске)
# Применяется ОДНОКРАТНО: если нет ни одного admin в БД.
# После первого запуска — смените пароль через профиль!
# При ADMIN_EMAIL="" или ADMIN_PASSWORD="" bootstrap пропускается.
ADMIN_EMAIL=admin@company.local
ADMIN_PASSWORD=change_me_on_first_login

# ── Часовой пояс ─────────────────────────────────────────────
TZ=Europe/Moscow

# ── Immich (фотогалерея) ─────────────────────────────────────
# Версия Immich ("release" = последняя стабильная)
IMMICH_VERSION=release
# Пароль PostgreSQL для Immich (отдельный инстанс)
IMMICH_DB_PASSWORD=change_me_immich_db_password
# Путь для загрузок Immich на хост-машине (bind mount)
IMMICH_UPLOAD_LOCATION=./immich_upload_data
# Внутренний URL Immich (используется backend для API-запросов)
IMMICH_URL=http://immich-server:2283
# Публичный URL Immich (используется фронтом для ссылки "Все фото →")
IMMICH_PUBLIC_URL=https://photos.portal.company.local
# API-ключ сервисного аккаунта (создать в Immich: Administration → API Keys)
# Оставьте пустым — виджет будет скрыт
IMMICH_API_KEY=
# UUID корпоративного shared-альбома (создать в Immich UI после первого запуска)
# Оставьте пустым — виджет будет скрыт
IMMICH_CORP_ALBUM_ID=

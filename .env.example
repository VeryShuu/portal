# ============================================================
# Portal — переменные окружения
# Скопируйте в .env и заполните значения
#
# Все остальные настройки (Keycloak, Nextcloud, логирование,
# лимиты файлов, Prometheus и др.) задаются через
# Admin UI → Администрирование после первого запуска.
# ============================================================

# === Container images (registry) ===
# IMAGE_PREFIX — registry-префикс для имён образов.
#   Пусто (по умолчанию) = образы собираются локально из исходников (dev, staging).
#   ghcr.io/veryshuu/ = pull готовых CI-образов из GitHub Container Registry (prod).
# IMAGE_TAG — тег образов.
#   v1.x.x  = релизный тег; ОБЯЗАТЕЛЕН для prod-контура (ADR-047, semver-lock).
#             Прод обновляется только при явной смене тега, а не на каждый merge в main.
#             Доступные теги: gh release list --repo VeryShuu/portal
#   latest  = последний successful CI-билд из main (ТОЛЬКО dev/experiments;
#             на проде отвергается setup.sh в prod-профиле).
#   sha-XXXXXXX = точная привязка к коммиту (для диагностики/отката; short-SHA из CI-лога).
# См. ADR-045 (CI-built images in GHCR + pull-based deploy), ADR-047 (semver-lock).
IMAGE_PREFIX=
IMAGE_TAG=latest

# === PostgreSQL (required) ===
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=change_me_strong_password

# === Redis (required) ===
REDIS_PASSWORD=change_me_redis_password
# Лимит памяти Redis (по умолчанию 256mb). Политика вытеснения — volatile-lru:
# выселяются ТОЛЬКО ключи с TTL (кэш/сессии/idempotency), а очередь ARQ и другие
# ключи без TTL защищены от потери. Поднимайте при росте числа сессий/SSE-стримов.
REDIS_MAXMEMORY=256mb

# === Backend (required) ===
# SECRET_KEY: не менее 32 символов, используется для подписи сессий
SECRET_KEY=change_me_32_chars_minimum_secret_key_here
ENVIRONMENT=production

# DATABASE_URL и REDIS_URL собираются автоматически в docker-compose.yml
# из POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB и REDIS_PASSWORD выше —
# дублировать пароль здесь не нужно. Если запускаете backend вне Compose,
# укажите URL вручную в окружении процесса.

# === Nginx ports ===
HTTP_PORT=80
HTTPS_PORT=443

# === Локальная аутентификация / Bootstrap ===
# Включить/выключить вход по email+паролю (аварийный/bootstrap режим)
LOCAL_AUTH_ENABLED=true
# Email и пароль первого admin (bootstrap при первом запуске)
# Применяется ОДНОКРАТНО: если нет ни одного admin в БД.
# После первого запуска — смените пароль через профиль!
# При ADMIN_EMAIL="" или ADMIN_PASSWORD="" bootstrap пропускается.
ADMIN_EMAIL=admin@company.local
ADMIN_PASSWORD=change_me_on_first_login
ADMIN_PASSWORD_RESET_ON_START=false

# === Screenshot service ===
# Shared-secret между бэкендом и контейнером screenshot-service.
# Генерируется автоматически через setup.sh; вручную задавать не нужно.
# Без него screenshot-service возвращает 503 на все запросы.
SCREENSHOT_SERVICE_SECRET=
# (опционально) Allowlist origin'ов для endpoint /screenshot (защита от SSRF).
# Формат: через запятую, например "https://portal.company.local,https://kb.company.local".
# Если пусто — endpoint /screenshot отключён (PDF-экспорт KB через /pdf работает без этого).
SCREENSHOT_ALLOWED_ORIGINS=

# === Synthetic-проверки (опциональный мониторинг user-flow) ===
# Креды для synthetic-пробы login_and_load (local-auth). Без них проба skip-ается.
# Можно переиспользовать bootstrap-admin (ADMIN_EMAIL/ADMIN_PASSWORD) или создать
# отдельный сервисный аккаунт. Метрики: portal_synthetic_probe_up/duration_seconds.
# Подробности и диагностика No data / ok=0: docs/monitoring.md §3 (Synthetic probes).
PROBE_ADMIN_EMAIL=
PROBE_ADMIN_PASSWORD=
# URL frontend'а изнутри docker-сети:
#   prod  (nginx-маршрутизатор) → http://nginx:80
#          (НЕ http://frontend:80 — portal-frontend это чистый статиксервер
#           без /api/ proxy → probe получит 405 на login POST. См. docs/monitoring.md §3)
#   dev   (Vite dev-server с proxy) → http://frontend:5173
PROBE_FRONTEND_URL=http://nginx:80

# === База данных: пул соединений ===
# Размер постоянного пула asyncpg-соединений (по умолчанию 20).
# Поднимать при росте RPS / появлении TimeoutError при checkout.
DB_POOL_SIZE=20
# Максимальный «overflow» сверх pool_size. Итоговый предел = pool_size + max_overflow.
DB_MAX_OVERFLOW=30
# Время жизни соединения, секунды (защита от stale-коннектов через NAT/PgBouncer).
DB_POOL_RECYCLE=3600

# Вывод SQL-запросов в логи включается автоматически, когда уровень логирования
# выставлен в DEBUG (Admin UI → Мониторинг → Логирование). Отдельной env-переменной нет.

# === Observability (overlay monitoring/docker-compose.monitoring.yml) ===
# Эти переменные использует ТОЛЬКО observability-overlay, который НЕ подключается
# к базовому прод-деплою автоматически — его поднимают явно через
# `docker compose -f docker-compose.yml -f monitoring/docker-compose.monitoring.yml up -d ...`.
# См. monitoring/README.md и docs/monitoring.md §7.

# Grafana: admin-учётка первого входа. Пароль — дефолтный `admin`, Grafana
# принудительно требует сменить его при первом входе.
GRAFANA_ADMIN_USER=admin

# Если в system.json::metrics_token задан — передаём сюда для scrape-авторизации.
# Пусто = /metrics открыт (допустимо в закрытом периметре/VPN).
PORTAL_METRICS_TOKEN=

# SMTP для доставки алертов (Alertmanager → email админам). Независимый от
# портального SMTP путь — алерты уходят даже если упал backend/email_outbox.
# Пустой ALERT_SMTP_HOST = алерты видны только в UI Alertmanager (без доставки).
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=25
ALERT_SMTP_FROM=portal-alerts@company.local
# Получатели через запятую:
ALERT_ADMINS_EMAIL=admins@company.local
# SMTP auth (если relay требует; пусто = без auth):
# NB: кавычки НЕ обязательны и НЕ снимаются Docker Compose. Скрипт
# render-alertmanager.sh срезает одну пару внешних " или ' автоматически,
# но лучше писать без них:  ALERT_SMTP_PASSWORD=secret  (а не  ="secret")
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=

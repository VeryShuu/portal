# ============================================================
# Portal — переменные окружения
# Скопируйте в .env и заполните значения
#
# Все остальные настройки (Keycloak, Nextcloud, логирование,
# лимиты файлов, Prometheus и др.) задаются через
# Admin UI → Администрирование после первого запуска.
# ============================================================

# === Container images (registry) ===
# IMAGE_PREFIX — registry-префикс для имён образов.
#   Пусто (по умолчанию) = образы собираются локально из исходников (dev, staging).
#   forgejo.mage.ru/mage/ = pull готовых CI-образов из Forgejo Container Registry (prod).
# IMAGE_TAG — тег образов.
#   v1.x.x  = релизный тег; ОБЯЗАТЕЛЕН для prod-контура (ADR-047, semver-lock).
#             Прод обновляется только при явной смене тега, а не на каждый merge в main.
#             Доступные теги: https://forgejo.mage.ru/mage/portal/releases
#   latest  = последний successful CI-билд из main (ТОЛЬКО dev/experiments;
#             на проде отвергается setup.sh в prod-профиле).
#   sha-XXXXXXX = точная привязка к коммиту (для диагностики/отката; short-SHA из CI-лога).
# См. ADR-045 (CI-built images in Forgejo Container Registry + pull-based deploy),
#     ADR-047 (semver-lock), ADR-048 (миграция GitHub → Forgejo).
IMAGE_PREFIX=
IMAGE_TAG=latest

# === Forgejo registry auth (ОБЯЗАТЕЛЬНО для prod-контура) ===
# Репо mage/portal приватный → registry-pull, bundle-download и latest-tag-check
# авторизуются через FORGEJO_TOKEN (PAT). Создайте deploy-токен в
# forgejo.mage.ru → Settings → Applications → Generate New Token
# (scope: read:package + read:repository), владельцем будет FORGEJO_USER.
# setup.sh использует их для `docker login forgejo.mage.ru` и curl-запросов к API.
# В dev-контуре НЕ нужны (локальная сборка, без обращения к registry/releases).
FORGEJO_USER=
FORGEJO_TOKEN=

# === PostgreSQL (required) ===
# Сгенерируйте пароль: `openssl rand -base64 24`
POSTGRES_DB=portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=

# === Redis (required) ===
# Сгенерируйте пароль: `openssl rand -hex 24`
REDIS_PASSWORD=
# Лимит памяти Redis (по умолчанию 256mb). Политика вытеснения — volatile-lru:
# выселяются ТОЛЬКО ключи с TTL (кэш/сессии/idempotency), а очередь ARQ и другие
# ключи без TTL защищены от потери. Поднимайте при росте числа сессий/SSE-стримов.
REDIS_MAXMEMORY=256mb

# === Backend (required) ===
# SECRET_KEY: используется для подписи сессий и деривации Fernet-ключа
# (шифрование helpdesk-mailbox паролей at-rest). Компрометация ключа =
# необратимая компрометация всех at-rest секретов.
# Сгенерируйте: `openssl rand -hex 48`
# ВАЖНО: в production (ENVIRONMENT=production) валидируется Settings:
#   - минимум 48 символов (96 hex при `openssl rand -hex 48`)
#   - не входит в block-list известных дефолтов
# См. audit [C1], ADR-037.
SECRET_KEY=
ENVIRONMENT=production

# DATABASE_URL и REDIS_URL собираются автоматически в docker-compose.yml
# из POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB и REDIS_PASSWORD выше —
# дублировать пароль здесь не нужно. Если запускаете backend вне Compose,
# укажите URL вручную в окружении процесса.

# === Nginx ports ===
HTTP_PORT=80
HTTPS_PORT=443

# === Локальная аутентификация / Bootstrap ===
# Включить/выключить вход по email+паролю (аварийный/bootstrap режим).
# По умолчанию ВЫКЛЮЧЕН (backdoor закрыт). Включается осознанно через
# `./setup.sh` (который предложит Y/n) или явным LOCAL_AUTH_ENABLED=true.
LOCAL_AUTH_ENABLED=false
# Email и пароль первого admin (bootstrap при первом запуске).
# Применяется ОДНОКРАТНО: если нет ни одного admin в БД.
# После первого запуска — смените пароль через профиль!
# При ADMIN_EMAIL="" или ADMIN_PASSWORD="" bootstrap пропускается.
# В production (ENVIRONMENT=production) Settings отклоняет дефолт
# "change_me_on_first_login". Запустите `./setup.sh` для интерактивной
# генерации, либо задайте надёжный пароль явно.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PASSWORD_RESET_ON_START=false

# === Модуль обучения (LMS) ===
# Пароль DB-роли learning_app (ТЗ learning.md §10.8): все learning-роуты
# работают через отдельный пул соединений с грантами только на learning_*-
# таблицы + INSERT на email_outbox (миграция 102). Роль создаётся миграцией.
# ОБЯЗАТЕЛЬНО на production (без неё learning-роуты уйдут на общий движок —
# допустимо только в dev/тестах). Сгенерируйте: openssl rand -hex 24.
# Пароль синхронизируется с ролью при каждом старте миграций (migrate.sh →
# scripts/ensure_learning_db_role.py), поэтому добавление переменной в уже
# развёрнутый контур достаточно: после рестарта роль обновится сама.
LEARNING_DB_PASSWORD=

# Напоминание о дедлайне курса (этап 2, learning): за сколько суток до
# deadline_at ежедневный cron (07:15) шлёт непрошедшим участникам одно письмо.
# Опционально; по умолчанию 3.
LEARNING_DEADLINE_REMINDER_DAYS=3

# === Screenshot service ===
# Shared-secret между бэкендом и контейнером screenshot-service.
# Генерируется автоматически через setup.sh; вручную задавать не нужно.
# Без него screenshot-service возвращает 503 на все запросы.
SCREENSHOT_SERVICE_SECRET=
# (опционально) Allowlist origin'ов для endpoint /screenshot (защита от SSRF).
# Формат: через запятую, например "https://portal.company.local,https://kb.company.local".
# Если пусто — endpoint /screenshot отключён (PDF-экспорт KB через /pdf работает без этого).
SCREENSHOT_ALLOWED_ORIGINS=
# (опционально) Максимальный размер тела запроса для /pdf (МБ). Бэкенд отправляет
# отрендеренный HTML статьи с inlined base64-медиа — aiohttp-дефолт 1 МБ → 413
# на крупных KB-статьях. 16 МБ покрывает богатый контент с запасом.
PDF_MAX_BODY_MB=16

# === Synthetic-проверки (опциональный внутренний local-auth flow) ===
# Credentials для login_and_load. Без них probe имеет состояние DISABLED.
# Используйте отдельный local-auth аккаунт с минимальной ролью reader; имя env
# историческое, права admin не требуются. Не переиспользуйте bootstrap-admin.
# Метрики: portal_synthetic_probe_up/duration_seconds.
# Подробности и диагностика No data / ok=0: docs/monitoring.md §3 (Synthetic probes).
PROBE_ADMIN_EMAIL=
PROBE_ADMIN_PASSWORD=
# URL frontend'а изнутри docker-сети:
#   prod  (nginx-маршрутизатор) → http://nginx:8080
#          (nginx внутри сети слушает :8080 — 80/443 только хостовый маппинг;
#           НЕ http://frontend:80 — portal-frontend это чистый статиксервер
#           без /api/ proxy → probe получит 405 на login POST. См. docs/monitoring.md §3)
#   dev   (Vite dev-server с proxy) → http://frontend:5173
#          (или http://nginx:8080 — через nginx dev-стека, который проксирует
#           / на Vite и /api на backend)
PROBE_FRONTEND_URL=http://nginx:8080

# === База данных: пул соединений ===
# Размер постоянного пула asyncpg-соединений (по умолчанию 20).
# Поднимать при росте RPS / появлении TimeoutError при checkout.
DB_POOL_SIZE=20
# Максимальный «overflow» сверх pool_size. Итоговый предел = pool_size + max_overflow.
DB_MAX_OVERFLOW=30
# Время жизни соединения, секунды (защита от stale-коннектов через NAT/PgBouncer).
DB_POOL_RECYCLE=3600

# Вывод SQL-запросов в логи включается автоматически, когда уровень логирования
# выставлен в DEBUG (Admin UI → Мониторинг → Логирование). Отдельной env-переменной нет.

# === Observability (overlay monitoring/docker-compose.monitoring.yml) ===
# Эти переменные использует ТОЛЬКО observability-overlay, который НЕ подключается
# к базовому прод-деплою автоматически — его поднимают явно через
# `docker compose -f docker-compose.yml -f monitoring/docker-compose.monitoring.yml up -d ...`.
# См. monitoring/README.md и docs/monitoring.md §7.

# На какой адрес биндить порты UI мониторинга (Prometheus/Alertmanager/exporter'ы;
# Grafana — отдельная GRAFANA_BIND ниже). 127.0.0.1 (дефолт) — доступ только
# с хоста (SSH-туннель/reverse-proxy); 0.0.0.0 — доступ из сети.
MONITORING_BIND=127.0.0.1

# Привязка Grafana: единственный UI мониторинга с собственной авторизацией,
# поэтому по умолчанию (без строки) смотрит в сеть — 0.0.0.0:3001.
# 127.0.0.1 — заблокировать, как остальные UI.
# GRAFANA_BIND=0.0.0.0

# Абсолютные ссылки Grafana (share-ссылки, уведомления из алертов).
# По умолчанию http://localhost:3001; при доступе из сети указать
# http://<имя-или-IP-сервера>:3001
# GRAFANA_ROOT_URL=http://localhost:3001

# Grafana: admin-учётка первого входа (создаётся только на СВЕЖЕМ volume
# grafana-data — при существующем volume смена пароля здесь ничего не делает).
GRAFANA_ADMIN_USER=admin
# ⚠️ ОБЯЗАТЕЛЬНО сменить (дефолт admin/admin на LAN-доступном :3001 недопустим).
# Пусто = вход admin/admin (только для оффлайн-отладки).
GRAFANA_ADMIN_PASSWORD=

# Плагины Grafana из catalog (качаются с grafana.com при старте контейнера).
# Logs Drilldown (Patterns-исследование логов без LogQL): grafana-lokiexplore-app
# NB: требует исходящего доступа к grafana.com; на закрытом проде оставить пустым.
GRAFANA_INSTALL_PLUGINS=

# Если в system.json::metrics_token задан — передаём сюда для scrape-авторизации.
# render-prometheus.sh при старте подставит его в конфиг Prometheus (Prometheus
# не умеет env в YAML — раньше токен оставался литеральной строкой).
# Пусто = /metrics открыт (допустимо в закрытом периметре/VPN).
PORTAL_METRICS_TOKEN=

# Внешние blackbox-пробы (доступность URL + срок TLS-сертификатов).
# Формат: name=url,name=url (одной строкой, без пробелов). Первая проба
# получает module http_2xx (TLS проверяется), вторая — http_2xx_insecure
# (self-signed/dev-имена). Пример:
#   BLACKBOX_TARGETS=portal=https://portal.mage.ru,forgejo=https://forgejo.mage.ru
#   BLACKBOX_TARGETS_INSECURE=devportal=http://portal-test.mage.ru
# Пусто = job blackbox без целей (алерты внешнего периметра молчат).
BLACKBOX_TARGETS=
BLACKBOX_TARGETS_INSECURE=

# Nginx exporter: где брать stub_status. Внутри контейнерной сети nginx
# ВСЕГДА слушает :8080/8443 (80/443 — только хостовый маппинг портов).
NGINX_SCRAPE_URI=http://nginx:8080/stub_status

# SMTP для доставки алертов (Alertmanager → email админам). Независимый от
# портального SMTP путь — алерты уходят даже если упал backend/email_outbox.
# Пустой ALERT_SMTP_HOST = алерты видны только в UI Alertmanager (без доставки).
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=25
# Требовать ли STARTTLS у SMTP-relay (Alertmanager default = true, «автоматики
# по порту» нет). Пусто = авто в render-alertmanager.sh: false при :25
# (plaintext LAN-relay), true иначе (587 = STARTTLS). Явное true/false
# приоритетнее автоподстановки.
ALERT_SMTP_REQUIRE_TLS=
ALERT_SMTP_FROM=portal-alerts@company.local
# Получатели через запятую:
ALERT_ADMINS_EMAIL=admins@company.local
# SMTP auth (если relay требует; пусто = без auth):
# NB: кавычки НЕ обязательны и НЕ снимаются Docker Compose. Скрипт
# render-alertmanager.sh срезает одну пару внешних " или ' автоматически,
# но лучше писать без них:  ALERT_SMTP_PASSWORD=secret  (а не  ="secret")
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=

# Алерты в Matrix (опционально — мгновенный канал дублем к email).
# Bridge jaywink/matrix-alertmanager живёт в compose-профиле `matrix`:
# поднятие: COMPOSE_PROFILES=matrix docker compose ... up -d matrix-alertmanager
# (bridge отдельный от portal messenger_outbox намеренно — алерты обязаны
# доходить при упавшем портале; email остаётся резервным каналом).
ALERT_MATRIX_HOMESERVER_URL=https://matrix.mage.ru
# Бот (можно существующего @portal-bot или отдельного alert-бота):
ALERT_MATRIX_USER=@portal-bot:matrix.mage.ru
ALERT_MATRIX_TOKEN=
# Маппинг «имя receiver'а alertmanager → комната»: admins-email/!ROOM_ID:matrix.mage.ru
ALERT_MATRIX_ROOMS=admins-email/!ROOM_ID:matrix.mage.ru
# Секрет на webhook-запросы bridge (пусто = без проверки):
ALERT_MATRIX_SECRET=
# Полный webhook-URL для конфига alertmanager (рендерится render-скриптом;
# пусто = webhook-блок вырезан, алерты только по email). При заданном
# ALERT_MATRIX_SECRET добавьте ?secret=<значение>:
ALERT_MATRIX_WEBHOOK_URL=http://matrix-alertmanager:3000/alerts

# --- Dead-man контроль пропажи мониторинга (MON-13) -------------------------
# Внешний независимый приёмник heartbeat: всегда-firing алерт Watchdog уходит
# ТОЛЬКО сюда (не в email). Если пинги пропали — умер Prometheus или
# Alertmanager, т.е. весь алертинг молча гибнет; внешний сервис обязан уметь
# тревожить при ПРОПАЖЕ пинга (healthchecks.io-совместимый webhook или
# self-hosted аналог в разрешённом периметре). Пинги каждые ~5 мин →
# grace-окно внешнего сервиса ставьте ≥ 3× интервала (напр. 30 мин).
# Пусто = внешний контроль не настроен (pending_external): приёмник становится
# no-op, Watchdog не спамит email, алерты видны только в UI Alertmanager.
ALERT_DEADMAN_WEBHOOK_URL=

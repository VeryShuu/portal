# Auto-generated by nginx-config sidecar — публичный контур обучения (ADR-051).
# Рендерится ТОЛЬКО при заданном learning_base_url в system.json и наличии
# TLS-сертификата; иначе файл заменяется пустым комментарием и контур закрыт.
#
# Отличия от портал-блока (ТЗ «Модуль обучения» §4):
#   - НЕТ CIDR-гейта ($allowed_network) — контур публичный;
#   - ЯВНЫЙ allowlist путей: учебная статика (frontend:81, отдельная сборка),
#     /api/v1/auth/learning/*, /api/v1/learning/me/* и GET /api/v1/learning/meta
#     на backend; остальной /api/v1/learning/* (admin/methodist) и всё прочее —
#     404 на границе nginx (PA-003);
#   - Keycloak/SSO на контуре отсутствует принципиально.

# HTTP → HTTPS для learn-хоста (портал слушает 8080 с server_name _ —
# выбор server-блока идёт по Host: заголовку).
server {
    listen 8080;
    server_name ${LEARN_HOST};

    return 301 https://$host$request_uri;
}

server {
    listen 8443 ssl;
    http2  on;
    server_name ${LEARN_HOST};

    ssl_certificate     ${LEARN_CERT};
    ssl_certificate_key ${LEARN_KEY};

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "DENY" always;
    add_header X-XSS-Protection          "0" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy        "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "${LEARN_CSP}" always;

    # Без прокси-заголовков двойные security-заголовки не появляются: backend
    # отдаёт свои только /api; скрываем их здесь на всякий случай так же, как
    # портал (nginx — единый источник заголовков).
    proxy_hide_header Content-Security-Policy;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-XSS-Protection;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Permissions-Policy;
    proxy_hide_header Strict-Transport-Security;

    set $backend_host  "backend:8000";

    # ── Allowlist API публичного контура ────────────────────────────────────
    # Вход/восстановление пароля: жёсткая личная зона (brute-force).
    location ~ ^/api/v1/auth/learning/ {
        limit_req zone=learning_auth burst=10 nodelay;
        proxy_pass         http://$backend_host;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout  60s;
        proxy_send_timeout  60s;
    }

    # Публичный мета-эндпоинт (iframe-origins для плеера; без аутентификации).
    location = /api/v1/learning/meta {
        limit_req zone=api burst=100 nodelay;
        proxy_pass         http://$backend_host;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout  60s;
        proxy_send_timeout  60s;
    }

    # Учебное API прохождения (принципал learner-сессии). Trailing slash:
    # /api/v1/learning/me сам по себе роутом не является.
    location /api/v1/learning/me/ {
        limit_req zone=api burst=100 nodelay;
        proxy_pass         http://$backend_host;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout  300s;
        proxy_send_timeout  300s;
        proxy_buffers       16 64k;
        proxy_buffer_size   64k;
    }

    # audit [PA-003]: всё остальное под /api/v1/learning/ (admin/methodist-
    # роуты, неизвестные пути) — 404 на границе, до backend. Длинный префикс
    # location выше выигрывает у этого, поэтому learner-пути доходят, а
    # административные — нет (двойная граница поверх backend-ACL).
    location /api/v1/learning/ {
        return 404;
    }

    # ── Статика learn-сборки (отдельный entry, без портальных чанков) ──────
    location / {
        proxy_pass         http://${LEARN_FRONTEND_HOST};
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_buffers      16 64k;
        proxy_buffer_size  64k;
    }
}

# Base image must stay in lockstep with monitoring/node-exporter-textfile/Dockerfile
# (both pin alpine:3.20). Dependabot does NOT scan this file (filename is not
# Dockerfile/*.dockerfile), so update both digests together when bumping alpine.
FROM alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc # pinned 2026-07-26

RUN apk add --no-cache inotify-tools jq gettext \
    || (sleep 10 && apk add --no-cache inotify-tools jq gettext) \
    || (sleep 20 && apk add --no-cache inotify-tools jq gettext)

COPY templates/ /templates/
COPY render-config.sh    /usr/local/bin/render-config.sh
COPY entrypoint-config.sh /usr/local/bin/entrypoint-config.sh

# Defensive: strip CRLF if a Windows editor reintroduces them (script
# wouldn't run otherwise — the kernel would look for "/bin/sh\r").
RUN sed -i 's/\r$//' /usr/local/bin/render-config.sh /usr/local/bin/entrypoint-config.sh \
    && chmod +x /usr/local/bin/render-config.sh /usr/local/bin/entrypoint-config.sh

# Healthcheck: rendered ssl_server.conf must exist (sidecar produces it on start).
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD test -s /data/nginx-conf/ssl_server.conf || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint-config.sh"]

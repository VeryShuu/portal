{
  "name": "portal-frontend",
  "version": "1.0.0",
  "description": "Portal — корпоративный интранет-портал (Vue 3 frontend)",
  "private": true,
  "license": "MIT",
  "author": "VeryShuu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VeryShuu/portal.git"
  },
  "homepage": "https://github.com/VeryShuu/portal",
  "bugs": {
    "url": "https://github.com/VeryShuu/portal/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run gen:types",
    "build": "vue-tsc --noEmit && vite build",
    "prebuild": "npm run gen:types",
    "pretypecheck": "npm run gen:types",
    "pretest:unit": "npm run gen:types",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint \"src/**/*.{ts,tsx,vue}\" \"tests/**/*.{ts,tsx,vue}\" --fix",
    "lint:check": "eslint \"src/**/*.{ts,tsx,vue}\" \"tests/**/*.{ts,tsx,vue}\"",
    "typecheck": "vue-tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.js",
    "gen:types": "openapi-typescript ../openapi.json -o src/api/types.gen.d.ts",
    "build:analyze": "ANALYZE=true vite build"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.101.4",
    "@tiptap/extension-focus": "^2.27.2",
    "@tiptap/extension-heading": "^2.27.2",
    "@tiptap/extension-highlight": "^2.27.2",
    "@tiptap/extension-link": "^2.4.0",
    "@tiptap/extension-paragraph": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.4.0",
    "@tiptap/extension-subscript": "^2.27.2",
    "@tiptap/extension-superscript": "^2.27.2",
    "@tiptap/extension-table": "^2.4.0",
    "@tiptap/extension-table-cell": "^2.4.0",
    "@tiptap/extension-table-header": "^2.4.0",
    "@tiptap/extension-table-row": "^2.4.0",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/extension-text-align": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/starter-kit": "^2.4.0",
    "@tiptap/vue-3": "^2.4.0",
    "@vicons/ionicons5": "^0.13.0",
    "blurhash": "^2.0.5",
    "dompurify": "^3.4.12",
    "flag-icons": "^7.5.0",
    "markdown-it": "^14.1.0",
    "naive-ui": "^2.38.0",
    "ofetch": "^1.3.0",
    "pinia": "^2.1.0",
    "prosemirror-markdown": "^1.13.5",
    "sortablejs": "^1.15.7",
    "tiptap-markdown": "^0.9.0",
    "vue": "^3.5.40",
    "vue-i18n": "^9.13.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.4",
    "@intlify/unplugin-vue-i18n": "^4.0.0",
    "@playwright/test": "^1.62.1",
    "@types/markdown-it": "^14.1.0",
    "@types/node": "^20.14.0",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "globals": "^15.15.0",
    "jsdom": "^24.1.3",
    "openapi-typescript": "^7.13.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^5.4.0",
    "vite": "^6.4.2",
    "vitest": "^4.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.0.0"
  }
}

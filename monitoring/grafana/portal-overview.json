          },
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{job=\"portal\", status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"portal\"}[5m])), 1)",
          "refId": "A"
